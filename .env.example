# ==============================================================================
# Virtual CFO Autonomous Multi-Agent System — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is in .gitignore.
# ==============================================================================

# --- Application Environment ---
APP_ENV=production
DEBUG=false

# --- PostgreSQL State Checkpointer ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Local:  postgresql://postgres:your-secure-password@localhost:5432/virtual_cfo
# Render: Use the Internal Database URL from your Render Postgres dashboard
# Neon:   Use the connection string from your Neon project
POSTGRES_URI=postgresql://postgres:your-secure-password@localhost:5432/virtual_cfo

# --- NVIDIA AI Foundation Endpoints (CFO Executive Recommendation Agent) ---
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Client timeout in seconds (default 15s ensures prompt fallback if remote inference delays)
NVIDIA_TIMEOUT=15.0

# --- Qdrant Vector Store (Bank Negara Malaysia 2026 Legal RAG) ---
# LOCAL development: use file-based embedded storage
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=legal_documents
# PRODUCTION: use Qdrant Cloud (comment out QDRANT_PATH, uncomment below)
# QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key-here

# --- CORS Allowed Origins (comma-separated) ---
# LOCAL:
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500
# PRODUCTION (update with your actual Vercel URL):
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:8000

# --- HuggingFace Transformers ---
# 0 = online (download models if needed), 1 = offline/cached only
HF_HUB_OFFLINE=1
